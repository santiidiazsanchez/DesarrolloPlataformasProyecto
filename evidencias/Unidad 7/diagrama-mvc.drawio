<mxfile host="app.diagrams.net"><diagram name="MVC incidentes"><mxGraphModel page="1" pageWidth="1100" pageHeight="560"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" parent="1" vertex="1" value="Ruta&#10;routes/incidentes.js&#10;autenticar · permitir(rol)&#10;validarCuerpo(zod)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#aec2d5;fontFamily=Arial;fontSize=14;"><mxGeometry x="30" y="40" width="190" height="120" as="geometry" /></mxCell><mxCell id="3" parent="1" vertex="1" value="Controlador&#10;controllers/incidentes.js&#10;Solo HTTP: lee req,&#10;llama al servicio y responde" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf8ee;strokeColor=#aec2d5;fontFamily=Arial;fontSize=14;"><mxGeometry x="250" y="40" width="190" height="120" as="geometry" /></mxCell><mxCell id="4" parent="1" vertex="1" value="Servicio&#10;services/incidentes.js&#10;Filtros, paginación,&#10;código INC, 400 y 404" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4df;strokeColor=#aec2d5;fontFamily=Arial;fontSize=14;"><mxGeometry x="470" y="40" width="190" height="120" as="geometry" /></mxCell><mxCell id="5" parent="1" vertex="1" value="Modelo&#10;models/incidentes.js&#10;Consultas Prisma y&#10;forma de la respuesta" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#aec2d5;fontFamily=Arial;fontSize=14;"><mxGeometry x="690" y="40" width="190" height="120" as="geometry" /></mxCell><mxCell id="6" parent="1" vertex="1" value="MySQL 8.4&#10;Índice (prioridad, estado)&#10;Usuarios e incidentes&#10;Volumen en Docker" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf8ee;strokeColor=#aec2d5;fontFamily=Arial;fontSize=14;"><mxGeometry x="910" y="40" width="160" height="120" as="geometry" /></mxCell><mxCell id="7" parent="1" vertex="1" value="utils/codigos.js&#10;aCodigo · desdeCodigo&#10;&quot;En revisión&quot; ↔ En_revision (un solo lugar)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f7f9fc;strokeColor=#aec2d5;fontFamily=