e="4" target="7" style="endArrow=block;endFill=1;dashed=1;strokeColor=#33557a;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="25" parent="1" edge="1" source="5" target="7" style="endArrow=block;endFill=1;dashed=1;strokeColor=#33557a;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="26" parent="1" edge="1" source="4" target="8" style="endArrow=block;endFill=1;dashed=1;strokeColor=#33557a;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="27" parent="1" vertex="1" value="Antes: el controlador validaba filtros y paginación y repetía 3 veces la conversión del código INC; la traducción de &quot;En revisión&quot; estaba en 4 lugares. Ahora cada capa tiene una sola responsabilidad." style="text;html=0;whiteSpace=wrap;align=center;fontFamily=Arial;fontSize=14;fontColor=#3d6185;"><mxGeometry x="30" y="490" width="1040" height="50" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
