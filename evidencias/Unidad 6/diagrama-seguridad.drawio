<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="Seguridad"><mxGraphModel page="1" pageWidth="1100" pageHeight="600"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" parent="1" vertex="1" value="1. React (navegador)&#10;Inicio de sesión&#10;Token en sessionStorage&#10;Authorization: Bearer" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#aec2d5;fontFamily=Arial;fontSize=15;"><mxGeometry x="30" y="30" width="230" height="120" as="geometry" /></mxCell><mxCell id="3" parent="1" vertex="1" value="2. CORS y Helmet&#10;Solo orígenes de CLIENT_ORIGIN&#10;Otro origen: 403&#10;Encabezados seguros, no-store" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf8ee;strokeColor=#aec2d5;fontFamily=Arial;fontSize=15;"><mxGeometry x="300" y="30" width="230" height="120" as="geometry" /></mxCell><mxCell id="4" parent="1" vertex="1" value="3. Límites de solicitudes&#10;100 por minuto por IP&#10;Login: 5 fallos cada 15 min&#10;Exceso: 429" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4df;strokeColor=#aec2d5;fontFamily=Arial;fontSize=15;"><mxGeometry x="570" y="30" width="230" height="120" as="geometry" /></mxCell><mxCell id="5" parent="1" vertex="1" value="4. Autenticación JWT&#10;Firma HS256 y vencimiento&#10;Cuenta activa y rol en MySQL&#10;Falla: 401" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#aec2d5;fontFamily=Arial;fontSize=15;"><mxGeometry x="840" y="30" width="230" height="120" as="geometry" /></mxCell><mxCell id="6" parent="1" vertex="1" value="5. Autorización por rol&#10;permitir(permisos.acción)&#10;Analista · Supervisor · Admin&#10;Sin permiso: 403" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf8ee;strokeColor=#aec2d5;fontFamily=Arial;fontSize=15;"><mxGeometry x="30" y="230" width="230" height="120" as="geometry" /></mxCell><mxCell id="7" parent="1" vertex="1" value="6. Validación y limpieza&#10;zod: campos, tipos y formato&#10;sanitize-html: sin etiquetas&#10;Error: 400 con cada campo" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4df;strokeColor=#aec2d5;fontFamily=Arial;fontSize=15;"><mxGeometry x="300" y="230" width="230" height="120" as="geometry" /></mxCell><mxCell id="8" parent="1" vertex="1" value="7. Controlador y Prisma&#10;Consultas parametrizadas&#10;Ids generados por MySQL&#10;Errores sin trazas internas" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf2ff;strokeColor=#aec2d5;fontFamily=Arial;fontSize=15;"><mxGeometry x="570" y="230" width="230" height="120" as="geometry" /></mxCell><mxCell id="9" parent="1" vertex="1" value="8. MySQL 8.4&#10;Usuario: passwordHash bcrypt&#10;Incidente: enums y título único&#10;Volumen en Docker" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf8ee;strokeColor=#aec2d5;fontFamily=Arial;fontSize=15;"><mxGeometry x="840" y="230" width="230" height="120" as="geometry" /></mxCell><mxCell id="10" parent="1" vertex="1" value="Permisos por rol (menor privilegio)&#10;Analista: consultar y crear&#10;Supervisor: consultar y actualizar&#10;Administrador: consultar, crear, actualizar y eliminar&#10;La API envía estos permisos al perfil y React oculta los botones." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f7f9fc;strokeColor=#aec2d5;fontFamily=Arial;fontSize=15;"><mxGeometry x="30" y="390" width="505" height="160" as="geometry" /></mxCell><mxCell id="11" parent="1" vertex="1" value="Respuestas controladas&#10;401 sin token, token alterado o vencido&#10;403 rol sin permiso u origen no permitido&#10;400 datos inválidos · 429 demasiadas solicitudes&#10;503 base no disponible · 500 sin detalles internos" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f7f9fc;strokeColor=#aec2d5;fontFamily=Arial;fontSize=15;"><mxGeometry x="565" y="390" width="505" height="160" as="geometry" /></mxCell><mxCell id="12" parent="1" vertex="1" value="En producción el tráfico llega cifrado por HTTPS (proxy con TLS); en local se probó con npm run certificado." style="text;html=0;align=center;fontFamily=Arial;fontSize=14;fontColor=#3d6185;"><mxGeometry x="30" y="165" width="1040" height="24" as="geometry" /></mxCell><mxCell id="13" parent="1" vertex="1" value="La interfaz oculta acciones, pero cada control se vuelve a comprobar en el servidor." style="text;html=0;align=center;fontFamily=Arial;fontSize=14;fontColor=#3d6185;"><mxGeometry x="30" y="565" width="1040" height="24" as="geometry" /></mxCell><mxCell id="20" parent="1" edge="1" source="2" target="3" style="endArrow=block;endFill=1;strokeColor=#33557a;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="21" parent="1" edge="1" source="3" target="4" style="endArrow=block;endFill=1;strokeColor=#33557a;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="22" parent="1" edge="1" source="4" target="5" style="endArrow=block;endFill=1;strokeColor=#33557a;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="23" parent="1" edge="1" source="6" target="7" style="endArrow=block;endFill=1;strokeColor=#33557a;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="24" parent="1" edge="1" source="7" target="8" style="endArrow=block;endFill=1;strokeColor=#33557a;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="25" parent="1" edge="1" source="8" target="9" style="endArrow=block;endFill=1;strokeColor=#33557a;strokeWidth=2;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="26" parent="1" edge="1" source="5" target="6" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#33557a;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="955" y="200" /><mxPoint x="145" y="200" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
