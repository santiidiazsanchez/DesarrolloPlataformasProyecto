# npm run configurar crea .env con contraseñas y secretos locales aleatorios.
COMPOSE_PROJECT_NAME=
POSTGRES_PASSWORD=
DATABASE_URL=
DATABASE_URL_PRUEBAS=
PORT=3001
# Clave de firma JWT: mínimo 32 caracteres, nunca se publica.
JWT_SECRET=
JWT_EXPIRES_IN=30m
# Orígenes del navegador que pueden llamar a la API, separados por comas.
CLIENT_ORIGIN=http://127.0.0.1:5173,http://127.0.0.1:4173
# Contraseñas de las cuentas de prueba (npm run db:ejemplos guarda solo su hash bcrypt).
CLAVE_ADMIN=
CLAVE_SUPERVISOR=
CLAVE_ANALISTA=
# Opcional: HTTPS local con npm run certificado.
# HTTPS_CERT=certificados/certificado.pem
# HTTPS_KEY=certificados/clave.pem
# Opcional: solicitudes por minuto por IP (100 por defecto).
# LIMITE_POR_MINUTO=100
# Producción (panel Environment de Render, no en este archivo): DATABASE_URL interna de Render,
# JWT_SECRET propio, CLIENT_ORIGIN con el dominio del cliente, HOST=0.0.0.0, TRUST_PROXY=3 y NODE_ENV=production.
